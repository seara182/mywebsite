    <!-- knees / hocks -->
    <g fill="none" stroke="#6E4520" stroke-width="1.6" stroke-linecap="round" opacity=".55">
      <path d="M110 336 q7 3 13 0"/><path d="M214 336 q7 3 14 0"/>
    </g>
    <g fill="#2b1a0e">
      <path d="M106 360 h17 q2 0 2 3 v7 h-21 v-7 q0 -3 2 -3z"/><path d="M211 360 h17 q2 0 2 3 v7 h-21 v-7 q0 -3 2 -3z"/>
    </g>

    <!-- head (nods while chewing) -->
    <g class="head">
      <!-- far ear + ossicones -->
      <ellipse cx="238" cy="86" rx="14" ry="6" fill="#B98337" transform="rotate(-58 238 86)"/>
      <g stroke="#D3A050" stroke-width="7" stroke-linecap="round">
        <line x1="247" y1="83" x2="244" y2="58"/><line x1="260" y1="82" x2="264" y2="60"/>
      </g>
      <g fill="#33200F"><ellipse cx="244" cy="55" rx="6.5" ry="7.5"/><ellipse cx="264" cy="57" rx="6.5" ry="7.5"/></g>
      <!-- skull + snout -->
      <use href="#gHead" fill="url(#gBase)"/>
      <g clip-path="url(#clipHead)">
        <path d="M245.4 105.6 L244.4 109.1 L239.8 110.2 L234.9 108.4 L235.6 104.8 L238.1 102.0 L242.2 101.4Z" fill="#A9592A" stroke="#A9592A" stroke-width="3.2" stroke-linejoin="round"/><path d="M257.0 90.7 L253.1 89.9 L252.2 85.9 L252.1 82.8 L256.1 81.2 L259.3 84.3 L259.7 86.9Z" fill="#B4652C" stroke="#B4652C" stroke-width="3.2" stroke-linejoin="round"/><path d="M273.6 96.8 L271.6 99.0 L269.2 97.4 L267.9 95.6 L269.2 91.6 L271.7 92.6 L274.1 93.5Z" fill="#9C4F24" stroke="#9C4F24" stroke-width="3.2" stroke-linejoin="round"/><path d="M234.3 123.9 L234.1 119.3 L236.2 115.9 L239.3 116.1 L242.6 119.3 L241.1 122.9 L238.2 123.5Z" fill="#B4652C" stroke="#B4652C" stroke-width="3.2" stroke-linejoin="round"/>
        <ellipse cx="246" cy="118" rx="12" ry="8" fill="#5A2D0C" opacity=".22"/>
        <path d="M284 96 C302 98 312 110 308 126 C300 132 290 131 282 129 C288 118 288 108 284 96 Z" fill="#7C5D4B"/>
      </g>
      <ellipse cx="300" cy="111" rx="2.4" ry="3.6" fill="#241409" transform="rotate(-12 300 111)"/>
      <!-- brow, eye, lashes -->
      <path d="M244 93 Q254 88 263 92" fill="none" stroke="#9C6524" stroke-width="2" stroke-linecap="round" opacity=".7"/>
      <g class="blink"><ellipse cx="254" cy="99" rx="6.2" ry="5.6" fill="#1B110A"/><circle cx="256.4" cy="97" r="1.9" fill="#fff"/></g>
      <g stroke="#1B110A" stroke-width="1.6" stroke-linecap="round"><line x1="249" y1="94.5" x2="246" y2="91"/><line x1="253" y1="93" x2="252" y2="89"/><line x1="258" y1="93.5" x2="259" y2="90"/></g>
      <!-- near ear -->
      <g transform="rotate(-28 228 101)"><ellipse cx="228" cy="101" rx="18" ry="7.5" fill="#D3A050"/><ellipse cx="228" cy="101" rx="11" ry="3.8" fill="#C0806A"/></g>
      <!-- mouth line + lower jaw -->
      <path d="M264 131 L299 128" stroke="#4A2A18" stroke-width="1.6" stroke-linecap="round" fill="none"/>
      <g class="jaw"><path d="M256 129 L296 130 C302 130 302 138 293 139 L263 141 C256 141 253 134 256 129 Z" fill="#DDB061"/><path d="M270 139 L295 137.4" stroke="#7C5D4B" stroke-width="3" stroke-linecap="round"/></g>
      <!-- the cable caught between the teeth -->
      <path d="M262 128 L285 127.5" stroke="#15151A" stroke-width="6.5" stroke-linecap="round"/>
    </g>

    <!-- grass -->
    <g fill="none" stroke="#81DAAC" stroke-width="2.2" stroke-linecap="round" opacity=".55">
