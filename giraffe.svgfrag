    <!-- giraffe: silhouette shapes are reused for fill + clipping so the patch pattern stays inside the body -->
    <defs>
      <linearGradient id="gBase" gradientUnits="userSpaceOnUse" x1="0" y1="226" x2="0" y2="366">
        <stop offset="0" stop-color="#E7BA68"/><stop offset=".5" stop-color="#EDCB86"/><stop offset="1" stop-color="#F5E4BC"/>
      </linearGradient>
      <linearGradient id="gShade" gradientUnits="userSpaceOnUse" x1="0" y1="226" x2="0" y2="306">
        <stop offset="0" stop-color="#5A2D0C" stop-opacity="0"/><stop offset="1" stop-color="#5A2D0C" stop-opacity=".34"/>
      </linearGradient>
      <linearGradient id="gRim" gradientUnits="userSpaceOnUse" x1="204" y1="0" x2="268" y2="0">
        <stop offset="0" stop-color="#5A2D0C" stop-opacity=".30"/><stop offset=".7" stop-color="#5A2D0C" stop-opacity="0"/>
      </linearGradient>
      <path id="gBody" d="M86 262 C84 242 104 232 128 232 C156 230 184 226 208 226 L246 262 C248 284 238 298 214 300 C190 304 150 304 124 300 C100 298 86 284 86 262 Z"/>
      <path id="gNeck" d="M204 236 C210 196 218 160 232 118 L272 132 C268 176 264 216 258 266 L236 292 L200 264 Z"/>
      <path id="gLegH" d="M98 286 L132 290 C134 312 126 326 125 340 L123 361 L108 361 L109 340 C108 326 98 312 98 286 Z"/>
      <path id="gLegF" d="M206 290 L240 290 C238 312 232 328 230 340 L228 361 L213 361 L214 340 C210 328 206 312 206 290 Z"/>
      <path id="gHead" d="M230 100 C230 82 250 74 268 82 C278 86 288 96 300 104 C308 110 308 122 298 128 L264 134 C244 138 230 122 230 100 Z"/>
      <clipPath id="clipSil"><use href="#gBody"/><use href="#gNeck"/><use href="#gLegH"/><use href="#gLegF"/></clipPath>
      <clipPath id="clipHead"><use href="#gHead"/></clipPath>
    </defs>

    <!-- far-side legs, darkened to sit behind the body -->
    <g>
      <use href="#gLegH" transform="translate(24 0)" fill="url(#gBase)"/><use href="#gLegH" transform="translate(24 0)" fill="#3a1f0a" opacity=".28"/>
      <use href="#gLegF" transform="translate(-24 0)" fill="url(#gBase)"/><use href="#gLegF" transform="translate(-24 0)" fill="#3a1f0a" opacity=".28"/>
      <g fill="#2b1a0e" opacity=".85">
        <path d="M130 360 h15 q2 0 2 3 v6 h-17 z"/><path d="M182 360 h15 q2 0 2 3 v6 h-17 z"/>
      </g>
    </g>

    <!-- tail: hangs from the rump, dark tuft at the end -->
    <path d="M90 246 C68 252 58 284 60 322" fill="none" stroke="#E2B462" stroke-width="5" stroke-linecap="round"/>
    <path d="M60 316 C50 328 51 346 60 356 C69 346 70 328 60 316 Z" fill="#3B2210"/>

    <!-- mane: bristles + solid core, behind the neck so only the edge shows -->
    <g stroke="#5B3416" stroke-linecap="round" stroke-width="3.4" fill="none"><path d="M204.0 236.0 L195.4 231.7"/><path d="M204.7 231.4 L196.2 227.1"/><path d="M205.4 226.8 L195.1 222.2"/><path d="M206.2 222.3 L197.4 217.9"/><path d="M206.9 217.8 L197.2 213.2"/><path d="M207.7 213.3 L200.1 209.0"/><path d="M208.5 208.8 L199.2 204.2"/><path d="M209.4 204.4 L201.5 199.9"/><path d="M210.2 199.9 L200.6 195.1"/><path d="M211.1 195.5 L204.6 191.2"/><path d="M212.0 191.1 L203.0 186.2"/><path d="M213.0 186.6 L206.2 182.2"/><path d="M214.0 182.2 L206.1 177.5"/><path d="M215.0 177.8 L207.2 173.0"/><path d="M216.1 173.3 L209.6 168.9"/><path d="M217.1 168.8 L208.5 163.8"/><path d="M218.3 164.4 L211.4 159.7"/><path d="M219.5 159.9 L212.7 155.2"/><path d="M220.7 155.4 L214.7 150.9"/><path d="M221.9 150.8 L215.3 146.1"/><path d="M223.2 146.2 L216.2 141.4"/><path d="M224.6 141.6 L216.8 136.5"/><path d="M225.9 137.0 L219.4 132.2"/><path d="M227.4 132.3 L219.9 127.2"/><path d="M228.9 127.6 L223.2 123.0"/><path d="M230.4 122.8 L224.0 117.9"/><path d="M232.0 118.0 L225.4 113.0"/></g>
    <path d="M204 236 C210 196 218 160 232 118" fill="none" stroke="#5B3416" stroke-width="9" stroke-linecap="round"/>

